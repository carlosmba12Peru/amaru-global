# Variables de Entorno del Backend FastAPI Multi-Agente
# Copiar este archivo a .env en la carpeta backend/

# Proyecto de Google Cloud Platform
PROJECT_ID=amaru-fen-demo
GCP_REGION=us-central1
GOOGLE_CLOUD_PROJECT=amaru-fen-demo
GOOGLE_CLOUD_LOCATION=us-central1

# Google Gemini / Vertex AI (Google AI Studio)
# Puedes usar GEMINI_API_KEY o GOOGLE_GEMINI_API_KEY
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=False

# Open-Meteo Professional (Opcional, cuenta con nivel gratuito sin key)
OPEN_METEO_API_KEY=your_open_meteo_key_optional

# Google Maps Platform (Geocodificación y elevación server-side)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Despacho Telegram (Bot Token y Canales COEL / Vecinal)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID_COEL=-1001234567890
TELEGRAM_CHAT_ID_VECINAL=-1009876543210
TELEGRAM_CHAT_ID=-1001234567890

# Modo de régimen estacional (EL_NINO o LA_NINA)
SEASON_MODE=EL_NINO
