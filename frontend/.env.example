# Variables de Entorno del Frontend (Next.js 14)
# Copiar este archivo a .env.local

# Deshabilitar SWC si hay problemas de binarios nativos en Windows
NEXT_DISABLE_SWC=1

# URL base del Backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clave de Google Maps Platform (Maps JavaScript API, Geocoding API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
